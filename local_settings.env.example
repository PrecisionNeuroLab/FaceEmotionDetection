# Copy to local_settings.env (gitignored) and keep only the lines you change.
# Videos:  MP4_ROOT/<patient>_MP4/*.mp4, patient photos in MP4_ROOT/<patient>_MP4/targetFace/*.jpg
# Outputs: OUT_ROOT/outputs_Combined/<patient>/ and OUT_ROOT/outputs_Combined_PatData/<patient>/
MP4_ROOT=/home/klab/NAS/Analysis/MP4
# Raw recordings, for --m2t: RAW_ROOT/<patient>/.../*.m2t
# RAW_ROOT=/path/to/raw
OUT_ROOT=/home/klab/NAS/Analysis
# DeepFace's VGG-Face weights (default: model_cache/ in the repo folder)
# DEEPFACE_HOME=/path/to/folder
